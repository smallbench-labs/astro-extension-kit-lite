---
import Base from '../layouts/Base.astro';
---
<Base lang="en" title="Page not found" path="/404/">
  <section class="mx-auto max-w-[1200px] px-6 pt-24 md:pt-32 pb-12">
    <p class="label">Error 404</p>
    <h1 class="mt-6 text-[clamp(2.4rem,5vw,3.4rem)] font-semibold tracking-tight leading-[1.05]">This tab doesn’t exist.</h1>
    <p class="mt-4 text-lg text-ink-2 max-w-[48ch]">The page may have moved. Try the home page, or press <kbd>⌘K</kbd> in your browser and search your tabs instead.</p>
    <a href="/" class="mt-10 inline-flex items-center min-h-11 bg-ink text-paper px-5 font-semibold hover:bg-signal hover:text-signal-ink">← Back home</a>
  </section>
</Base>
