---
import Base from '../layouts/Base.astro';
import StoreButtons from '../components/StoreButtons.astro';
import BrowserMock from '../components/BrowserMock.astro';
import { useT, type Lang } from '../i18n/ui';
import { product } from '../site.config';
import { getCollection } from 'astro:content';
const lang: Lang = 'en';
const t = useT(lang);
const latest = (await getCollection('changelog', (e) => e.id.startsWith('en/'))).sort((a, b) => +b.data.date - +a.data.date)[0];
const steps = [1, 2, 3] as const;
---
<Base lang={lang} path="/">
  <section class="mx-auto max-w-[1200px] px-6 pt-16 md:pt-24 grid lg:grid-cols-12 gap-12 items-center">
    <div class="lg:col-span-6">
      <p class="label">{t('hero.label')}{product.version}</p>
      <h1 class="mt-6 text-display font-semibold whitespace-pre-line">{t('hero.title')}</h1>
      <p class="mt-6 text-lg text-ink-2 max-w-[44ch] leading-relaxed">{t('hero.lead')}</p>
      <div class="mt-9"><StoreButtons lang={lang} /></div>
      <p class="mt-5 font-mono text-xs text-ink-2">{product.users} · ★ {product.rating} · {t('store.free')}</p>
    </div>
    <div class="lg:col-span-6"><BrowserMock /></div>
  </section>

  {latest && (
    <div class="mx-auto max-w-[1200px] px-6 mt-16">
      <a href="https://themes.formchime.com/themes/extension-kit/" class="flex flex-wrap items-center gap-4 border-y border-line py-3 text-sm hover:text-signal">
        <span class="font-mono text-xs bg-ink text-paper px-2 py-0.5">v{latest.data.version}</span>
        <span class="font-mono text-xs text-ink-2">{latest.data.date.toISOString().slice(0, 10)}</span>
        <span>{latest.body?.split('\n').find((l) => l.trim())?.trim()}</span><span class="ml-auto" aria-hidden="true">→</span>
      </a>
    </div>
  )}

  <section id="how" class="mx-auto max-w-[1200px] px-6 mt-24">
    <p class="label">01 / {t('how.label')}</p>
    <ol class="mt-8 grid md:grid-cols-3 border-t border-ink">
      {steps.map((n) => (
        <li class="pt-6 pb-8 md:pr-8 border-b md:border-b-0 md:border-r border-line last:border-r-0 md:[&:not(:first-child)]:pl-8">
          <span class="font-mono text-sm text-signal">{String(n).padStart(2, '0')}</span>
          <h2 class="mt-3 text-2xl font-semibold tracking-tight">{t(`how.${n}.t`)}</h2>
          <p class="mt-2 text-ink-2 leading-relaxed">{t(`how.${n}.d`)}</p>
        </li>
      ))}
    </ol>
  </section>

  <section id="permissions" class="mx-auto max-w-[1200px] px-6 mt-24 grid lg:grid-cols-12 gap-10">
    <div class="lg:col-span-4">
      <p class="label">02 / {t('perm.label')}</p>
      <h2 class="mt-6 text-[clamp(2rem,4vw,2.6rem)] leading-tight font-semibold tracking-tight">{t('perm.title')}</h2>
      <p class="mt-4 text-ink-2 leading-relaxed">{t('perm.lead')}</p>
    </div>
    <div class="lg:col-span-8 overflow-x-auto" tabindex="0" role="region" aria-label={t('perm.label')}>
      <table class="w-full text-sm border-t-2 border-ink">
        <thead><tr class="text-left font-mono text-xs uppercase tracking-wider text-ink-2"><th class="py-3 pr-4 font-normal">{t('perm.col.id')}</th><th class="py-3 pr-4 font-normal">{t('perm.col.why')}</th><th class="py-3 font-normal">{t('perm.col.never')}</th></tr></thead>
        <tbody>
          {product.permissions.map((p) => (
            <tr class="border-t border-line align-top">
              <td class="py-4 pr-4"><code class="font-mono text-[13px] bg-code px-1.5 py-0.5">{p.id}</code></td>
              <td class="py-4 pr-4 leading-relaxed">{t(p.why as any)}</td>
              <td class="py-4 leading-relaxed text-ink-2"><span class="text-signal font-mono mr-1.5" aria-hidden="true">✕</span>{t(p.never as any)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="mx-auto max-w-[1200px] px-6 mt-28">
    <div class="bg-ink text-paper px-8 md:px-14 py-14 grid md:grid-cols-2 gap-8 items-end">
      <div><h2 class="text-[clamp(2rem,4.5vw,3rem)] font-semibold tracking-tight leading-tight">{t('cta.title')}</h2><p class="mt-3 opacity-75">{t('cta.lead')}</p></div>
      <div class="md:justify-self-end"><a href={product.stores.chrome} class="inline-block bg-signal text-signal-ink px-6 py-3.5 font-semibold hover:bg-paper hover:text-ink">{t('store.chrome')} →</a></div>
    </div>
  </section>
</Base>
