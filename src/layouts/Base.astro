---
import '../styles/global.css';
import instrument from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url';
import { useT, type Lang } from '../i18n/ui';
import { product } from '../site.config';
interface Props { lang: Lang; title?: string; description?: string; path?: string; noindex?: boolean }
const { lang, title, description = useT(lang)('hero.lead'), path = '/', noindex = false } = Astro.props;
const t = useT(lang);
const nav = [ ['nav.features', '#how'], ['perm.label', '#permissions'] ] as const;
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title ? `${title} — ${product.name}` : `${product.name} — ${t('hero.title').replace(/\s*\n\s*/g, lang === 'en' ? ' ' : '')}`}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex" />}
  <link rel="preload" href={instrument} as="font" type="font/woff2" crossorigin />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="canonical" href={new URL(path, Astro.site).href} />
  <script is:inline>(function(){var q=new URLSearchParams(location.search).get('theme');var s=q||localStorage.getItem('theme');if(s==='dark'||(!s&&matchMedia('(prefers-color-scheme: dark)').matches))document.documentElement.classList.add('dark')})()</script>
</head>
<body class="min-h-dvh flex flex-col">
  <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:p-3 focus:bg-signal focus:text-signal-ink">{t('skip')}</a>
  <header class="sticky top-0 z-10 border-b border-line bg-paper/90 backdrop-blur-sm">
    <div class="mx-auto max-w-[1200px] px-6 h-16 flex items-center gap-8">
      <a href="/" class="flex items-center gap-2.5 font-semibold tracking-tight">
        <svg aria-hidden="true" width="22" height="22" viewBox="0 0 22 22"><rect x="1" y="5" width="20" height="16" rx="2" fill="none" stroke="currentColor" stroke-width="1.6"/><rect x="1" y="1" width="9" height="5" rx="1" fill="var(--signal)"/></svg>
        {product.name}
      </a>
      <nav aria-label="Main" class="hidden md:flex gap-2 text-sm text-ink-2">
        {nav.map(([k, href]) => <a class="inline-flex items-center min-h-11 px-2 hover:text-ink" href={href}>{t(k)}</a>)}
      </nav>
      <div class="ml-auto flex items-center gap-3 text-sm">
        <a href="https://themes.formchime.com/themes/extension-kit/" class="hidden lg:inline-flex items-center min-h-11 font-mono text-xs uppercase text-ink-2 hover:text-signal">Lite · Get full kit →</a>
        <button type="button" aria-label={t('theme.toggle')} class="size-11 grid place-items-center border border-line hover:border-ink-2" onclick="var d=document.documentElement.classList.toggle('dark');localStorage.setItem('theme',d?'dark':'light')">
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16"><circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M8 1.5a6.5 6.5 0 0 1 0 13z" fill="currentColor"/></svg>
        </button>
        <a href={product.stores.chrome} class="hidden sm:inline-flex items-center min-h-11 bg-ink text-paper px-4 font-medium hover:bg-signal hover:text-signal-ink">{t('nav.install')}</a>
        <details class="md:hidden relative">
          <summary class="list-none cursor-pointer size-11 grid place-items-center border border-line" aria-label="Menu"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 18 18"><path d="M2 5h14M2 9h14M2 13h14" stroke="currentColor" stroke-width="1.6"/></svg></summary>
          <nav aria-label="Mobile" class="absolute right-0 mt-2 w-60 bg-paper-2 border border-line py-1 z-20">
            {nav.map(([k, href]) => <a class="flex items-center min-h-11 px-4 hover:bg-paper" href={href}>{t(k)}</a>)}
            <a href={product.stores.chrome} class="flex items-center min-h-11 px-4 font-medium text-signal border-t border-line">{t('nav.install')}</a>
          </nav>
        </details>
      </div>
    </div>
  </header>
  <main id="main" class="flex-1"><slot /></main>
  <footer class="border-t border-line mt-24">
    <div class="mx-auto max-w-[1200px] px-6 py-10 flex flex-wrap gap-6 justify-between text-sm text-ink-2">
      <span class="font-mono text-xs">© 2026 {product.name} · v{product.version}</span>
      <div class="flex flex-wrap gap-x-5 items-center"><span>Astro Extension Kit Lite (MIT)</span><a href="https://themes.formchime.com/themes/extension-kit/" class="inline-flex items-center min-h-11 text-signal hover:underline">Full version: pricing, docs, changelog, privacy, onboarding, 3 languages →</a></div>
    </div>
  </footer>
  <script is:inline>document.addEventListener('keydown',function(e){if(e.key!=='Escape')return;document.querySelectorAll('details[open]').forEach(function(d){if(d.querySelector('nav,ul')){d.open=false;var s=d.querySelector('summary');if(s&&d.contains(document.activeElement))s.focus();}});});</script>
</body>
</html>
