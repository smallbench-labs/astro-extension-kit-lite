---
import { useT, type Lang } from '../i18n/ui';
import { product } from '../site.config';
const { lang } = Astro.props as { lang: Lang };
const t = useT(lang);
---
<div class="flex flex-wrap items-center gap-3">
  <a href={product.stores.chrome} class="inline-flex items-center gap-3 bg-signal text-signal-ink pl-3 pr-5 py-3 font-semibold hover:bg-ink hover:text-paper">
    <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4" fill="currentColor"/><path d="M12 8h9M8.5 14 4 6.5M15.5 14 11 21.5" stroke="currentColor" stroke-width="2"/></svg>
    {t('store.chrome')}
  </a>
  <a href={product.stores.edge} class="px-4 py-3 border border-ink/80 font-medium hover:bg-ink hover:text-paper">{t('store.edge')}</a>
  <a href={product.stores.firefox} class="px-4 py-3 border border-line font-medium text-ink-2 hover:border-ink hover:text-ink">{t('store.firefox')}</a>
</div>
