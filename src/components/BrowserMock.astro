---
import { product } from '../site.config';
const tabs = [
  ['Inbox (12)', 'mail.example.com'], ['Q4 planning — Doc', 'docs.example.com/q4'], ['Astro docs: i18n', 'docs.astro.build/en/guides/i18n'],
  ['Pull request #482', 'github.com/acme/app/pull/482'], ['Flight to Osaka', 'travel.example.com'],
];
---
<figure class="border border-line bg-paper-2 rounded-[10px] overflow-hidden shadow-[0_1px_0_var(--line),0_24px_48px_-24px_rgb(23_21_15/.25)]" aria-label="Product preview">
  <div class="flex items-center gap-3 px-4 h-11 border-b border-line">
    <div class="flex-1 h-6 bg-paper border border-line rounded-sm font-mono text-[11px] text-ink-2 flex items-center px-2.5">chrome://newtab</div>
    <span class="size-6 grid place-items-center bg-signal text-signal-ink rounded-sm text-[11px] font-mono font-medium">T</span>
    <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" class="text-ink-2"><path d="M6 2h3v2a1.5 1.5 0 0 0 3 0V2h2v4h-2a1.5 1.5 0 0 0 0 3h2v5H2V9h2a1.5 1.5 0 0 0 0-3H2V2z" fill="none" stroke="currentColor" stroke-width="1.2"/></svg>
  </div>
  <div class="p-5 md:p-7">
    <div class="flex items-center gap-3 border-2 border-ink px-3 h-11">
      <span class="font-mono text-sm text-ink-2">⌘K</span><span class="text-ink">pull req<span class="inline-block w-[2px] h-4 bg-signal align-middle ml-0.5"></span></span>
      <span class="ml-auto font-mono text-[11px] text-ink-2">47 tabs · 3 windows</span>
    </div>
    <ol class="mt-3 divide-y divide-line border border-line">
      {tabs.map(([title, url], i) => (
        <li class:list={['flex items-center gap-3 px-3 py-2.5 text-sm', i === 3 && 'bg-paper border-l-2 border-l-signal']}>
          <span class="font-mono text-[11px] text-ink-2 w-5">{String(i + 1).padStart(2, '0')}</span>
          <span class="font-medium truncate">{title}</span>
          <span class="ml-auto font-mono text-[11px] text-ink-2 truncate hidden sm:block">{url}</span>
          {i === 3 && <kbd>↵</kbd>}
        </li>
      ))}
    </ol>
    <p class="mt-4 font-mono text-[11px] text-ink-2 flex justify-between"><span>{product.name} v{product.version}</span><span class="text-ok">● indexed locally · 0 requests</span></p>
  </div>
</figure>
